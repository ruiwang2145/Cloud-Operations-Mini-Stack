# ---------------------------------------------------------------------------
# Cloud Operations Mini Stack -- environment template
#
# Copy to `.env` and fill in the values, or let `scripts/bootstrap.sh` do it.
# `.env` is git-ignored; this file is not. Never put a real secret in here.
# ---------------------------------------------------------------------------

# --- Service identity -------------------------------------------------------
SERVICE_NAME=cloud-ops-mini-stack
SERVICE_VERSION=1.1.0
DEPLOY_ENV=dev

# --- Django core ------------------------------------------------------------
DEBUG=True
# Generate with: python scripts/gen_secret.py
SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Required when Django is behind HTTPS with a different public origin:
# CSRF_TRUSTED_ORIGINS=https://cloudops.example.com

# --- Database ---------------------------------------------------------------
# Local development (no server required):
DATABASE_URL=sqlite:///db.sqlite3
# Production (Neon serverless PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/cloudops?sslmode=require
DB_CONN_MAX_AGE=600
DB_CONNECT_TIMEOUT=5

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# json (machine-parseable, the default) | console (readable, for a terminal)
LOG_FORMAT=json
# True for local development so `app.log` can be grepped.
# Set to False in containers: stdout is collected by the log driver there.
LOG_TO_FILE=True
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- Error tracking ---------------------------------------------------------
# Leave empty to disable Sentry entirely (it is optional, not required).
SENTRY_DSN=
SENTRY_ENV=dev
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Off by default: request bodies and headers routinely carry credentials.
SENTRY_SEND_PII=False

# --- Prometheus / SLO -------------------------------------------------------
# Empty -> the SLO reporter falls back to the in-process registry.
# Inside docker-compose this is the Prometheus service name.
PROMETHEUS_URL=
PROMETHEUS_QUERY_TIMEOUT=3
SLO_AVAILABILITY_TARGET=0.995
SLO_LATENCY_TARGET_MS=300
SLO_LATENCY_COMPLIANCE_TARGET=0.99
SLO_WINDOW=30d
SLO_CACHE_SECONDS=15

# --- API --------------------------------------------------------------------
API_PAGE_SIZE=20
API_ANON_THROTTLE=120/min

# --- Fault injection --------------------------------------------------------
# Enables /boom/ and /sentry-debug/. MUST stay False in production: they are
# there to prove that alerting works, not to be reachable by the public.
ENABLE_FAULT_ENDPOINTS=False
